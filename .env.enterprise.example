PI_POSTGRES_DB=pi_enterprise
PI_POSTGRES_USER=pi_enterprise
PI_POSTGRES_PASSWORD=replace-for-local-development
PI_POSTGRES_PORT=5432
PI_MINIO_ROOT_USER=pi_enterprise_local
PI_MINIO_ROOT_PASSWORD=replace-with-at-least-32-characters
PI_MINIO_API_PORT=19000
PI_MINIO_CONSOLE_PORT=19001
PI_MINIO_BUCKET=pi-artifacts

# Auth (OIDC mode by default)
PI_AUTH_MODE=oidc
PI_OIDC_ISSUER=https://your-oidc-provider.example.com
PI_OIDC_CLIENT_ID=pi-enterprise
# Required only for confidential OIDC clients. Never expose this to the browser.
PI_OIDC_CLIENT_SECRET=
PI_OIDC_AUDIENCE=pi-enterprise
PI_OIDC_ROLES_CLAIM=roles
PI_OIDC_ORGANIZATION_CLAIM=org_id
# Must exactly match the callback registered at the identity provider.
PI_OIDC_REDIRECT_URI=http://localhost:30141/api/enterprise/v1/auth/callback
